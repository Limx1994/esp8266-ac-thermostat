rule cc
  command = gcc -std=c11 -Wall -Wextra -Werror -I main -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
rule link
  command = gcc $in -o $out
build build_ascii/rules.o: cc main/rules.c
build build_ascii/rules_test.o: cc tests/rules_test.c
build build_ascii/rules_test.exe: link build_ascii/rules.o build_ascii/rules_test.o
default build_ascii/rules_test.exe
